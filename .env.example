# =============================================================================
# gtm-videogen-deepagents Environment Configuration
# Copy to .env and fill in your provider API keys.
# Offline mock mode (--mock / GTM_VIDEOGEN_MOCK=true) requires NO API keys.
# =============================================================================

# --- LLM & Vision Providers ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=

# --- Media Generation Providers ---
FAL_KEY=
HF_API_KEY=
HF_API_KEY_ID=
HF_API_KEY_SECRET=

# --- Model Tiers & Defaults ---
GTM_FAST_MODEL=anthropic/claude-haiku-5.5
GTM_FLAGSHIP_MODEL=anthropic/claude-sonnet-5.5
GTM_TEXT_MODEL=anthropic/claude-sonnet-5.5
GTM_VISION_MODEL=google/gemini-3.8-flash
GTM_IMAGE_MODEL=fal-ai/flux/schnell
GTM_VIDEO_MODEL=kling/v4/flash/text-to-video
GTM_VOICE_MODEL=fal-ai/elevenlabs/tts/eleven-v3
GTM_SFX_MODEL=mirelo-ai/sfx2.0/text-to-audio
GTM_MUSIC_MODEL=fal-ai/stable-audio-25/text-to-audio

# --- Storage & Paths ---
GTM_DATA_DIR=.data
GTM_RUNS_DIR=.data/runs
GTM_CACHE_DIR=.data/cache
GTM_FONTS_DIR=assets/fonts

# --- Runtime Limits & Timeouts ---
GTM_DEFAULT_CAP_USD=5.0
GTM_MAX_CONCURRENT_JOBS=4
GTM_HTTP_CONNECT_TIMEOUT_SEC=15.0
GTM_HTTP_READ_TIMEOUT_SEC=90.0
GTM_HTTP_WRITE_TIMEOUT_SEC=30.0
GTM_HTTP_POOL_TIMEOUT_SEC=15.0
GTM_HTTP_MAX_RETRIES=3

# --- Local Media Tools ---
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TESSERACT_BIN=tesseract
OCR_LANG=eng
WHISPER_BIN=
WHISPER_MODEL_PATH=
WHISPER_LANG=en

# --- API Server ---
GTM_API_HOST=0.0.0.0
GTM_API_PORT=8000
GTM_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GTM_LOG_LEVEL=INFO
